{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/assets/*", "/*.{css,js,json,svg,png,jpg,jpeg,ico,webmanifest,woff,woff2}", "/offline.html"]
  },
  "mimeTypes": { ".webmanifest": "application/manifest+json" },
  "routes": [
    { "route": "/service-worker.js", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/api/*", "headers": { "Cache-Control": "no-store" } }
  ]
}
