{
  "bindings": [
    {
      "authLevel": "anonymous",
      "type": "httpTrigger",
      "direction": "in",
      "name": "req",
      "route": "{*path}",
      "methods": ["get", "head", "post", "put", "patch", "delete", "options"]
    },
    { "type": "http", "direction": "out", "name": "res" }
  ]
}
